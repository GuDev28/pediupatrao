    {
      "name": "2. Pedido: entrada e cálculo no servidor",
      "item": [
        {
          "name": "ATENDENTE - registrar pedido tentando forçar total (servidor ignora)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "atendente01",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "atendente123",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"tipoEntrega\": \"ENTREGA\",\n  \"observacao\": \"Sem cebola\",\n  \"itens\": [\n    {\n      \"produtoId\": \"{{produtoId}}\",\n      \"quantidade\": 2,\n      \"precoUnitario\": 0.01\n    }\n  ],\n  \"valorTotal\": 0.01,\n  \"status\": \"FINALIZADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado: 201\", function () { pm.response.to.have.status(201); });",
                  "var p = pm.response.json(); pm.collectionVariables.set(\"pedidoId\", p.id);",
                  "pm.test(\"Total calculado pelo servidor (não é 0.01)\", function () { pm.expect(Number(p.valorTotal)).to.be.above(1); });",
                  "pm.test(\"Status inicial RECEBIDO\", function () { pm.expect(p.status).to.eql(\"RECEBIDO\"); });"
                ]
              }
            }
          ]
        },
