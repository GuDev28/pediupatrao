                  "pm.test(\"Fecha com o faturamento do resumo\", function () { var f = pm.collectionVariables.get(\"faturamentoPeriodo\"); if (f) { pm.expect(Math.abs(j.totalFaturamento - Number(f))).to.be.below(0.01); } });"
