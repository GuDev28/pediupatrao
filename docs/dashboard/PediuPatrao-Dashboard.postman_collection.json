                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado: 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Traz período padrão e opções\", function () { pm.expect(j.periodoPadrao.dias).to.eql(30); pm.expect(j.periodoMaximoDias).to.eql(366); pm.expect(j.status).to.have.lengthOf(7); pm.expect(j.tiposEntrega).to.have.lengthOf(2); });"
                ]
              }
            }
          ]
        },
        {
          "name": "RF01 - Resumo do período",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/resumo?dataInicio={{dataInicio}}&dataFim={{dataFim}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard",
                "resumo"
              ],
              "query": [
                {
                  "key": "dataInicio",
                  "value": "{{dataInicio}}"
                },
                {
                  "key": "dataFim",
                  "value": "{{dataFim}}"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "gerente01",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "gerente123",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado: 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Indicadores com comparação\", function () { [\"faturamento\",\"pedidos\",\"ticketMedio\",\"itensVendidos\"].forEach(function (k) { pm.expect(j[k]).to.have.property(\"atual\"); pm.expect(j[k]).to.have.property(\"anterior\"); pm.expect(j[k]).to.have.property(\"variacaoPercentual\"); }); });",
                  "pm.test(\"Período anterior tem a mesma duração\", function () { pm.expect(j.periodoAnterior.dias).to.eql(j.periodo.dias); });",
                  "pm.test(\"Ticket médio = faturamento / pedidos\", function () { if (j.pedidos.atual > 0) { pm.expect(Math.abs(j.ticketMedio.atual - j.faturamento.atual / j.pedidos.atual)).to.be.below(0.01); } });",
                  "pm.collectionVariables.set(\"faturamentoPeriodo\", j.faturamento.atual);"
                ]
              }
            }
          ]
        },
        {
          "name": "RF02 - Série de vendas por semana",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/vendas/serie?dataInicio={{dataInicio}}&dataFim={{dataFim}}&agrupamento=SEMANA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard",
                "vendas",
                "serie"
              ],
              "query": [
                {
                  "key": "dataInicio",
                  "value": "{{dataInicio}}"
                },
                {
                  "key": "dataFim",
                  "value": "{{dataFim}}"
                },
                {
                  "key": "agrupamento",
                  "value": "SEMANA"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "gerente01",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "gerente123",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado: 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Agrupamento semanal\", function () { pm.expect(j.agrupamento).to.eql(\"SEMANA\"); pm.expect(j.pontos.length).to.be.above(0); });",
                  "pm.test(\"Soma dos pontos = total\", function () { var s = j.pontos.reduce(function (a, p) { return a + p.faturamento; }, 0); pm.expect(Math.abs(s - j.totalFaturamento)).to.be.below(0.05); });"
                ]
              }
            }
          ]
        },
