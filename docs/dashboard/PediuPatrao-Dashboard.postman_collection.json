        {
          "name": "Sem autenticação -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/resumo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard",
                "resumo"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado: 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Erro em JSON com mensagem\", function () { var j = pm.response.json(); pm.expect(j.status).to.eql(401); pm.expect(j.mensagem).to.be.a(\"string\").and.not.empty; });"
                ]
